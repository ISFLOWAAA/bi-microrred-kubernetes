	partition 'Tareas de cómputo' = m
		mode: import
		source =
				let
					Origen = PostgreSQL.Database(ServidorPG, BasePG),
					Tabla = Origen{[Schema = "gold", Item = "v_pbi_tarea"]}[Data],
					Columnas = Table.SelectColumns(Tabla, {"tarea_id", "fecha_key", "hora_key", "inversor_sk", "dispositivo_key", "perfil_tarea_key", "ts_inicio", "ts_fin", "duracion_min", "epocas", "batch_size", "parametros_modelo", "nucleos_cpu", "archivos", "e_carga_wh", "e_incremental_wh", "e_fv_wh", "e_red_wh", "fraccion_solar", "costo_cop", "cobertura_pct"}),
					Tipos = Table.TransformColumnTypes(Columnas, {{"tarea_id", Int64.Type}, {"fecha_key", Int64.Type}, {"hora_key", Int64.Type}, {"inversor_sk", Int64.Type}, {"dispositivo_key", Int64.Type}, {"perfil_tarea_key", Int64.Type}, {"ts_inicio", type datetime}, {"ts_fin", type datetime}, {"duracion_min", type number}, {"epocas", Int64.Type}, {"batch_size", Int64.Type}, {"parametros_modelo", Int64.Type}, {"nucleos_cpu", Int64.Type}, {"archivos", Int64.Type}, {"e_carga_wh", type number}, {"e_incremental_wh", type number}, {"e_fv_wh", type number}, {"e_red_wh", type number}, {"fraccion_solar", type number}, {"costo_cop", type number}, {"cobertura_pct", type number}})
