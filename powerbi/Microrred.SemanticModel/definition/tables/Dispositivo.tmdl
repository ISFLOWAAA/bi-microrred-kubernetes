table 'Dispositivo'

	column 'dispositivo_key'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: dispositivo_key

	column 'codigo'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: codigo

	column 'Dispositivo'
		dataType: string
		summarizeBy: none
		sourceColumn: nombre

	column 'Tipo de dispositivo'
		dataType: string
		summarizeBy: none
		sourceColumn: tipo

	column 'inversor_id'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: inversor_id

	column 'Hardware'
		dataType: string
		summarizeBy: none
		sourceColumn: hardware

	partition 'Dispositivo' = m
		mode: import
		source =
				let
					Origen = PostgreSQL.Database(ServidorPG, BasePG),
					Tabla = Origen{[Schema = "gold", Item = "dim_dispositivo"]}[Data],
					Columnas = Table.SelectColumns(Tabla, {"dispositivo_key", "codigo", "nombre", "tipo", "inversor_id", "hardware"}),
					Tipos = Table.TransformColumnTypes(Columnas, {{"dispositivo_key", Int64.Type}, {"codigo", type text}, {"nombre", type text}, {"tipo", type text}, {"inversor_id", Int64.Type}, {"hardware", type text}})
				in
					Tipos
