table 'Fecha'
	dataCategory: Time

	column 'fecha_key'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: fecha_key

	column 'Fecha'
		dataType: dateTime
		formatString: dd/mm/yyyy
		isKey
		summarizeBy: none
		sourceColumn: fecha

	column 'Año'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: anio

	column 'Trimestre'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: trimestre

	column 'Nº de mes'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: mes

	column 'Día'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: dia_mes

	column 'Mes'
		dataType: string
		summarizeBy: none
		sourceColumn: nombre_mes
		sortByColumn: 'Nº de mes'

	column 'Día de la semana'
		dataType: string
		summarizeBy: none
		sourceColumn: nombre_dia
		sortByColumn: 'Nº día semana'

	column 'Año-Mes'
		dataType: string
		summarizeBy: none
		sourceColumn: anio_mes

	column 'Semana ISO'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: semana_iso

	column 'Nº día semana'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: dia_semana

	column 'Fin de semana'
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_fin_de_semana

	column 'Tipo de día'
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_dia

	column 'Periodo académico'
		dataType: string
		summarizeBy: none
		sourceColumn: periodo_academico

	hierarchy Calendario
		level Año
			column: 'Año'
		level Mes
			column: 'Mes'
		level Día
			column: 'Día'

	partition 'Fecha' = m
		mode: import
		source =
				let
					Origen = PostgreSQL.Database(ServidorPG, BasePG),
					Tabla = Origen{[Schema = "gold", Item = "dim_fecha"]}[Data],
					Filtrado = Table.SelectRows(Tabla, each [fecha_key] > 0 and [fecha] <= #date(2026, 7, 31)),
					Columnas = Table.SelectColumns(Filtrado, {"fecha_key", "fecha", "anio", "trimestre", "mes", "dia_mes", "nombre_mes", "nombre_dia", "anio_mes", "semana_iso", "dia_semana", "es_fin_de_semana", "tipo_dia", "periodo_academico"}),
					Tipos = Table.TransformColumnTypes(Columnas, {{"fecha_key", Int64.Type}, {"fecha", type date}, {"anio", Int64.Type}, {"trimestre", Int64.Type}, {"mes", Int64.Type}, {"dia_mes", Int64.Type}, {"nombre_mes", type text}, {"nombre_dia", type text}, {"anio_mes", type text}, {"semana_iso", Int64.Type}, {"dia_semana", Int64.Type}, {"es_fin_de_semana", type logical}, {"tipo_dia", type text}, {"periodo_academico", type text}})
				in
					Tipos
