table 'Tipo de evento'

	column 'tipo_evento_key'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: tipo_evento_key

	column 'Código'
		dataType: string
		summarizeBy: none
		sourceColumn: codigo

	column 'Evento'
		dataType: string
		summarizeBy: none
		sourceColumn: nombre

	column 'Categoría de evento'
		dataType: string
		summarizeBy: none
		sourceColumn: categoria

	column 'Severidad'
		dataType: string
		summarizeBy: none
		sourceColumn: severidad

	column 'Es de calidad de datos'
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_calidad_dato

	partition 'Tipo de evento' = m
		mode: import
		source =
				let
					Origen = PostgreSQL.Database(ServidorPG, BasePG),
					Tabla = Origen{[Schema = "gold", Item = "dim_tipo_evento"]}[Data],
					Columnas = Table.SelectColumns(Tabla, {"tipo_evento_key", "codigo", "nombre", "categoria", "severidad", "es_calidad_dato"}),
					Tipos = Table.TransformColumnTypes(Columnas, {{"tipo_evento_key", Int64.Type}, {"codigo", type text}, {"nombre", type text}, {"categoria", type text}, {"severidad", type text}, {"es_calidad_dato", type logical}})
				in
					Tipos
