    {
      "id": 5,
      "type": "timeseries",
      "title": "Flujo de energía",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-microrred"
      },
      "description": "Potencia promedio por minuto: lo que genera el sol, lo que consumen las cargas y lo que se toma de la red.",
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-microrred"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts_minuto AS time, p_fv_w AS \"Solar\", p_carga_w AS \"Consumo\", p_red_w AS \"Red\"\n  FROM gold.fact_energia_minuto\n WHERE inversor_id = $inversor AND $__timeFilter(ts_minuto)\n ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": 120000,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Solar"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2B705"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Consumo"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3D7DD8"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Red"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9B7BC9"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Energía en el periodo",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-microrred"
      },
      "description": "Energía acumulada en el rango de tiempo elegido arriba a la derecha.",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-microrred"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(e_fv_wh) / 1000 AS \"Solar\", sum(e_carga_wh) / 1000 AS \"Consumo\", sum(e_red_wh) / 1000 AS \"Red\"\n  FROM gold.fact_energia_minuto\n WHERE inversor_id = $inversor AND $__timeFilter(ts_minuto)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "fixed"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Solar"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2B705"
                }
              }
            ]
