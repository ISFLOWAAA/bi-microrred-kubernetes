    {
      "id": 8,
      "type": "gauge",
      "title": "Autosuficiencia",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-microrred"
      },
      "description": "Parte del consumo que NO vino de la red en el periodo (K6). Línea base del año: 40 % inv. 1, 28 % inv. 2.",
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-microrred"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT greatest(0, least(100, 100 * (1 - sum(e_red_wh) / nullif(sum(e_carga_wh), 0)))) AS \"Autosuficiencia\"\n  FROM gold.fact_energia_minuto\n WHERE inversor_id = $inversor AND $__timeFilter(ts_minuto)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
